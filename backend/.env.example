# =============================================================================
# Plantilla de variables. Copiar a backend/.env y ajustar.
#
# Los valores marcados "# dev:" funcionan tal cual contra
# infra/docker/docker-compose.dev.yml.
#
# Generar secretos robustos:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# ---- App --------------------------------------------------------------------
NODE_ENV=development
PORT=3100
APP_NAME=ERP Veterinario

# ---- Base de datos ----------------------------------------------------------
# dev: postgresql://postgres:postgres@localhost:5435/vet_demo
# prod: usar vet_app_user (solo EXECUTE sobre app.*), ver db/migrations/90_grants.sql
# El backend se conecta con `vet_app_user`, que solo tiene EXECUTE sobre app.*:
# si un SP no lo expone, el backend no lo ve. El rol lo crea 90_grants.sql sin
# contraseña utilizable; hay que fijarla y ponerla aquí:
#   ALTER ROLE vet_app_user WITH PASSWORD '<secreto>';
# Conectarse como `postgres` funciona y deja sin efecto toda esa separación.
DATABASE_URL=postgresql://vet_app_user:CAMBIAME@localhost:5435/vet_demo
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---- JWT --------------------------------------------------------------------
JWT_ACCESS_SECRET=CAMBIAR_MINIMO_32_CARACTERES_AAAAAAAAAAAA
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=CAMBIAR_MINIMO_32_CARACTERES_DIFERENTE_BBBB
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=veterp
JWT_AUDIENCE=veterp-backoffice

# Portal del propietario: emisor y audiencia distintos para que un token del
# portal jamás sirva en el backoffice, ni al revés.
JWT_PORTAL_ISSUER=veterp-portal
JWT_PORTAL_AUDIENCE=veterp-clientes

# ---- Cookies ----------------------------------------------------------------
COOKIE_SECRET=CAMBIAR_MINIMO_16_CARACTERES
COOKIE_SECURE=false

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=vet:

# ---- MinIO / S3 (historias clínicas, radiografías, consentimientos) ---------
STORAGE_ENDPOINT=http://localhost:9102
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=ChangeMe!2026
STORAGE_BUCKET=vet-docs
STORAGE_USE_SSL=false
STORAGE_REGION=us-east-1

# ---- Cifrado de secretos en reposo ------------------------------------------
# Con esta llave se cifra la clave del PSE que se guarda por empresa. Si cambia,
# las claves ya guardadas dejan de poder descifrarse y hay que volver a cargarlas.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=CAMBIAR_MINIMO_32_CARACTERES_CCCCCCCCCC

# ---- Facturación electrónica (PSE: The Factory HKA) -------------------------
# PSE_MODE=sandbox → no sale a la red, simula la aceptación de SUNAT.
# PSE_MODE=real    → usa las credenciales cargadas en Configuración → Empresa.
PSE_PROVIDER=the_factory_hka
PSE_MODE=sandbox
PSE_ENDPOINT=
PSE_TIMEOUT_MS=15000

# ---- Correo (recordatorios de vacunas y citas) ------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vet Patitas <no-reply@vetpatitas.pe>

# ---- Seguridad --------------------------------------------------------------
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
RATE_LIMIT_MAX=200
# Cuántos proxies hay delante del backend. Detrás del nginx del despliegue: 1.
# Sin proxy (desarrollo): vacío. Si se pone a un número mayor del real, el
# cliente puede falsificar su IP y saltarse el límite de intentos de login.
TRUST_PROXY=
BCRYPT_ROUNDS=10

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
