# =============================================================================
# Variables del compose de producción. Copiar a infra/docker/.env (NO se
# versiona) y reemplazar TODO. Cada secreto se genera por separado:
#   openssl rand -hex 32
# Las que van dentro de una URL (VET_APP_PASSWORD) deben ser hex o base64url.
# =============================================================================

# ---- Dominio -----------------------------------------------------------------
PUBLIC_APP_URL=https://vet.tudominio.com
PUBLIC_API_URL=/api
# Puerto que publica `web`. Detrás de un proxy TLS en el mismo host:
#   WEB_PORT=127.0.0.1:8080   y   TRUST_PROXY=2
WEB_PORT=80
TRUST_PROXY=1
COOKIE_SECURE=true

# ---- Postgres ------------------------------------------------------------------
POSTGRES_PASSWORD=
# Rol con el que se conecta el backend (solo EXECUTE sobre app.*). El servicio
# `migrate` se la fija al rol en cada arranque.
VET_APP_PASSWORD=

# ---- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=

# ---- MinIO ---------------------------------------------------------------------
# Administrador de MinIO (solo para minio-init y para el operador).
MINIO_ROOT_USER=veterp-admin
MINIO_ROOT_PASSWORD=
# Usuario de la aplicación, limitado al bucket vet-docs (lo crea minio-init).
STORAGE_ACCESS_KEY=veterp-app
STORAGE_SECRET_KEY=

# ---- Secretos del backend -----------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=
# Cifra las credenciales del PSE guardadas por empresa. Si cambia, hay que
# volver a cargarlas.
ENCRYPTION_KEY=

# ---- Facturación electrónica ---------------------------------------------------
PSE_MODE=sandbox
PSE_ENDPOINT=

# ---- Correo (opcional) --------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Clínica <no-reply@tudominio.com>
