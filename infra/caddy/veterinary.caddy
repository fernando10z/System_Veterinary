# =============================================================================
# Caddy — ERP Veterinary (servidor erp-prod). Hace el papel de frontend/nginx.conf
# fuera de Docker: sirve la SPA, reenvía /api al backend y /veterinary (bucket)
# a MinIO, con las mismas cabeceras de seguridad.
#
#   Cloudflare (TLS) → cloudflared → Caddy 127.0.0.1:5373 → api :3200 / MinIO :9000
#
# Instalado en /etc/caddy/sites/veterinary.caddy (copia; tras editar aquí:
#   cp infra/caddy/veterinary.caddy /etc/caddy/sites/ && caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy)
# =============================================================================
:5373 {
	bind 127.0.0.1
	encode gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	}

	# Formularios JSON: 1 MB. Los archivos tienen su propio límite (50 MB).
	@archivos path /api/archivos /veterinary /veterinary/*
	request_body @archivos {
		max_size 50MB
	}
	@api_resto {
		path /api/*
		not path /api/archivos
	}
	request_body @api_resto {
		max_size 1MB
	}

	# Solo llega tráfico del tunnel (Caddy escucha en 127.0.0.1). La IP real del
	# cliente la pone el edge de Cloudflare en CF-Connecting-IP; el backend la lee
	# de X-Forwarded-For con TRUST_PROXY=1 (límite de intentos de login, bitácora).
	handle /api/* {
		reverse_proxy 127.0.0.1:3200 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto https
			transport http {
				response_header_timeout 300s
			}
		}
	}

	# URLs firmadas de MinIO (subida directa y descarga). El Host se conserva
	# porque forma parte de la firma (STORAGE_PUBLIC_ENDPOINT).
	handle /veterinary* {
		header Referrer-Policy no-referrer
		reverse_proxy 127.0.0.1:9000 {
			header_up X-Forwarded-Proto https
			flush_interval -1
		}
	}

	handle {
		root * /srv/apps/erp-veterinary/current/frontend
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
