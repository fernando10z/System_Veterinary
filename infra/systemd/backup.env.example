# /etc/veterp/backup.env — configuración de db/scripts/backup.sh, restore.sh y
# restore-test.sh. Permisos 600, dueño root: lleva contraseñas.

# ---- Base (Opción A, Docker: contenedor del compose de producción) ----------
DB_CONTAINER=veterp-prod-postgres-1
DB_NAME=veterp
DB_USER=postgres
# ---- …u Opción B (Postgres en el host) ---------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_PASSWORD=

BACKUP_DIR=/var/backups/veterp
BACKUP_RETENTION_DAYS=14

# Cifrado (uno de los dos). Sin la clave o la frase, el backup no se puede
# restaurar: guardarlas fuera del servidor.
# BACKUP_GPG_RECIPIENT=backups@tuclinica.pe
# BACKUP_PASSPHRASE_FILE=/etc/veterp/backup.pass

# Copia fuera del servidor (uno de los dos)
# BACKUP_RCLONE_REMOTE=b2:veterp-backups
# BACKUP_S3_URI=s3://veterp-backups/clinica-1

# Archivos clínicos
MINIO_BACKUP=1
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=veterp-app
MINIO_SECRET_KEY=
MINIO_BUCKET=vet-docs
MINIO_DOCKER_NETWORK=veterp-prod_default

# Aviso si falla (recibe el mensaje en $1)
# BACKUP_ALERT_CMD='curl -fsS -m 10 -d "$1" https://ntfy.sh/mi-clinica-backups'
